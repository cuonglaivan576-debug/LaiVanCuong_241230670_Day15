@model List<TaiSan>
        <!-- Tài sản mới nhập -->
        <div class="section-head">
            <h3>@ViewBag.TieuDe</h3>
        </div>
        <div class="grid">
            @foreach (var ts in Model)
            {
                <div class="asset-card">
                    <a href="#"><img src="~/images/Img_1.jpg" alt="" /></a>
                    <h2>@ts.TenTs</h2>
                    <div class="asset-foot"><span class="price">@($"{ts.NguyenGia:0} tr")</span><button class="btn-buy">Chi tiết</button></div>
                </div>
            }
            
</main>